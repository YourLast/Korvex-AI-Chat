# Korvex AI Chat — server settings. Copy to .env.local and edit. Every setting is optional unless noted.

# --- Storage ---
# Where the database, uploaded files and keys live (default: ./data).
# DATA_DIR=./data

# --- Models ---
# Model list (default: ./models.config.json). Start from models.config.example.json.
# MODELS_CONFIG=./models.config.json

# --- Accounts ---
# Allow self sign-up without an invite link (1 = yes).
ALLOW_SIGNUP=0
# Send cookies only over HTTPS. Set to 1 in production behind HTTPS; 0 works for local http://localhost.
COOKIE_SECURE=0

# --- Voice input ---
# OpenAI-compatible speech-to-text server: POST {STT_URL}/audio/transcriptions.
STT_URL=http://127.0.0.1:8000/v1
# File with the bearer key for the STT server, if it needs one.
# STT_KEY_FILE=

# --- Chat titles and user memory (background calls to a model) ---
# OpenAI-compatible endpoint and model for short service calls. Empty URL turns the feature off.
# KX_TITLE_ENGINE_URL=
# KX_TITLE_ENGINE_MODEL=
# KX_MEMORY_ENGINE_URL=      # defaults to KX_TITLE_ENGINE_URL
# KX_MEMORY_ENGINE_MODEL=    # defaults to KX_TITLE_ENGINE_MODEL

# --- Web search tool ---
# SearXNG JSON endpoint, e.g. http://searxng:8080/search. Empty = web search is off.
# KX_SEARX_URL=

# --- Web Push ---
# Contact for push services: mailto: address or https URL of your site.
# VAPID_SUBJECT=mailto:admin@example.com

# --- Support contacts shown in notices (empty = not shown) ---
# KX_SUPPORT_EMAIL=
# KX_SUPPORT_TG=

# --- File previews (Office documents rendered in a throwaway Docker container) ---
# KX_PREVIEW_IMAGE=korvex-preview:1

# --- Code mode (off unless configured; needs Docker on the host — run it only on an isolated machine) ---
# KORVEX_CODE_IMAGE=korvex-code:1
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Anthropic models (Claude API) ---
# Key files are listed in models.config.json (anthropicKeys); a custom API base:
# KX_ANTHROPIC_BASE_URL=
